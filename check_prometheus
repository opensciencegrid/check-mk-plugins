#!/bin/bash

MY_TOKEN="$1"
HOSTNAME="$2"
PORT="$3"

# List of components that must have a status of 5
COMPONENTS=(
    "config-updates"
    "director"
    "federation"
    "prometheus"
    "registry"
    "storage"
    "web-ui"
    "xrootd"
    "IO-concurrency"
)

# Fetch all metrics once to avoid multiple HTTP calls
METRICS_DATA=$(wget -qO- --header="Authorization: Bearer $MY_TOKEN" "https://$HOSTNAME:$PORT/metrics" 2>/dev/null)

# Exit with code 1 if metrics couldn't be fetched
if [ -z "$METRICS_DATA" ]; then
    echo "CRITICAL: Unable to fetch metrics or empty response."
    exit 1
fi

CRITICAL=0

for comp in "${COMPONENTS[@]}"; do
    # Extract the value for pelican_component_health_status{component="<comp>"}
    VAL=$(echo "$METRICS_DATA" | grep -E "pelican_component_health_status\{component=\"$comp\"\}" | awk '{print $2}')

    if [ -z "$VAL" ]; then
        echo "CRITICAL: Component '$comp' status missing."
    elif [ "$VAL" -ne 5 ]; then
        echo "CRITICAL: Component '$comp' status is $VAL (expected 5)."
        CRITICAL=1
    else
        echo "OK: Component '$comp' status is 5."
    fi
done

if [ "$CRITICAL" -eq 1 ]; then
    exit 2
fi

exit 0
