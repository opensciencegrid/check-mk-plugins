#!/usr/bin/python3
# vim: tabstop=8 expandtab shiftwidth=4 softtabstop=4

import argparse
import sys
import time
import os
import subprocess

# Nagios exit status
STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3

def main():
    args = parse_args()
    states = [STATE_OK]
    messages = []
    extra_vars = {}
    if args.extra_vars:
        try:
            #parse extra condor configs to overwrite default: 
            #example args from command like: --extra-vars _condor_VAR1=value1;_condor_VAR2=value2
            #parsed to dictionary extra_vars = {'_condor_VAR1' : value1, '_condor_VAR2' : value2}
            extra_vars = dict((k.strip(), v.strip())
                             for k, v in (element.split('=')
                                 for element in args.extra_vars.split(';')))
       # except Exception as e:
        #    states.append(STATE_UNKNOWN)
         #   messages.append(str(e) + " Please review --extra-vars option")
          #  print (messages)
    
            for var in extra_vars.keys():
                if var.startswith('_condor_'):
                    os.environ[var] = str(extra_vars[var])
                    #print (var + os.environ[var])
                else:
                    messages.append("Extra variable not valid, should start with \'_condor_\', ignoring")
        except Exception as e:
            states.append(STATE_UNKNOWN)
            messages.append(str(e) + " Please review --extra-vars option")
            print (messages)


    # Use condor_status rather than the htcondor2 bindings: on large pools
    # the bindings over-release Py_None and Python aborts mid-query
    # ("none_dealloc: deallocating None", exit 134).
    # os.environ (with any extra_vars) is inherited by condor_status.
    daemon_ads = []
    try:
        result = subprocess.run(
            ['condor_status', '-pool', args.collector, '-any', '-af', 'Name'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True, timeout=args.timeout)
        if result.returncode == 0:
            daemon_ads = [line for line in result.stdout.splitlines() if line.strip()]
        else:
            # Connection failed
            states.append(STATE_CRITICAL)
            error = result.stderr.strip().splitlines()
            messages.append((error[-1] if error else "condor_status exited %d" % result.returncode)
                            + " " + args.collector + " failed.")
    except subprocess.TimeoutExpired:
        states.append(STATE_CRITICAL)
        messages.append("condor_status timed out after %d seconds. %s failed." % (args.timeout, args.collector))
    except Exception as e:
        # Other error
        states.append(STATE_UNKNOWN)
        messages.append(str(e) + " " + args.collector+ " failed.")

    number_of_daemons = len(daemon_ads)
    if number_of_daemons:
        messages.append(str(number_of_daemons) + " active daemons")
    elif max(states) == STATE_OK:
        # Query succeeded but returned nothing
        messages.append("status unknown")
        states.append(STATE_UNKNOWN)

    state = max(states)
    message = ', '.join(messages)

    perf_data = ' |daemons=%d' % number_of_daemons

    if not message:
        message = 'OK'

    print(message + perf_data)
    sys.exit(state)

def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument('--collector', dest='collector', type=str,
                        help='Collector hostname for condor_status -pool')
    parser.add_argument('--extra-vars', dest='extra_vars', type=str, 
                        help='Overwrite variables defined in condor_config_val, seperated by \';\', e.g. _condor_VAR1=value1;_condor_VAR2=value2')
    parser.add_argument('--timeout', dest='timeout', type=int, default=50,
                        help='Seconds to wait for condor_status (default 50)')
    return parser.parse_args()

if __name__ == "__main__":
    # Run script as main
    main()
