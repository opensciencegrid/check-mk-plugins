import sys
import socket
import json
from urllib.parse import urlparse

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------

def ensure_fqdn(host):
    """
    Validates and normalizes a hostname into an FQDN.
    Resolves shortnames via local DNS if necessary.
    """
    if not host or not isinstance(host, str):
        return None

    host = host.strip().lower()

    # If it already contains dots, consider it an FQDN candidate
    if '.' in host:
        return host

    # Fallback to local DNS lookup for shortnames
    try:
        fqdn = socket.getfqdn(host)
        if '.' in fqdn:
            return fqdn.lower()
    except Exception:
        pass

    return None


def extract_host_from_url(url_string):
    """
    Safely extract the hostname (FQDN) from a URL string.
    Handles schemes (http://, https://) as well as bare host:port strings.
    """
    if not url_string or not isinstance(url_string, str):
        return None

    # Prepend scheme if missing so urlparse extracts netloc correctly
    if not url_string.startswith(('http://', 'https://')):
        url_string = 'https://' + url_string

    try:
        parsed = urlparse(url_string)
        # parsed.hostname automatically strips port numbers and normalizes lowercase
        return parsed.hostname
    except Exception:
        return None


# ------------------------------------------------------------------------------
# Core Registry Parser
# ------------------------------------------------------------------------------

def get_registry_servers(registry_data):
    """
    Extract origins and caches from OSDF topology/registry data by prioritizing
    'url' and 'webUrl' endpoint attributes over path prefixes.
    """
    origins = set()
    caches = set()

    # Support list or dict response structures
    entries = registry_data if isinstance(registry_data, list) else registry_data.values()

    for item in entries:
        if not isinstance(item, dict):
            continue

        # Collect URL strings explicitly
        candidate_urls = [
            item.get('url'),
            item.get('webUrl'),
            item.get('endpoint'),
        ]

        # Parse nested endpoints if available
        for ep in item.get('endpoints', []):
            if isinstance(ep, dict):
                candidate_urls.extend([ep.get('url'), ep.get('webUrl')])

        # Extract FQDNs from valid URL fields
        extracted_hosts = set()
        for u in candidate_urls:
            host = extract_host_from_url(u)
            if host:
                fqdn = ensure_fqdn(host)
                if fqdn:
                    extracted_hosts.add(fqdn)

        # Categorize by top-level registryPrefix or resource type
        prefix = item.get('registryPrefix', '') or item.get('prefix', '')
        resource_type = str(item.get('type', '')).lower()

        if prefix.startswith('/caches') or 'cache' in resource_type:
            caches.update(extracted_hosts)
        elif prefix.startswith('/origins') or 'origin' in resource_type:
            origins.update(extracted_hosts)

    return origins, caches


# ------------------------------------------------------------------------------
# Main Execution / Verification
# ------------------------------------------------------------------------------

def main():
    # Example OSDF Registry JSON payload
    sample_registry_json = [
        {
            "registryPrefix": "/caches/CIT_LIGO_OSDFCACHE",
            "type": "cache",
            "url": "https://osdfcache.ligo.caltech.edu:8443",
            "webUrl": "https://osdfcache.ligo.caltech.edu:8444"
        },
        {
            "registryPrefix": "/origins/OSG_STORAGE",
            "type": "origin",
            "url": "https://origin.osgdev.org:1094"
        }
    ]

    print("Processing OSDF Registry Data...")
    origins, caches = get_registry_servers(sample_registry_json)

    print("\n--- Discovered Caches ---")
    for cache in sorted(caches):
        print(f"  [CACHE]  {cache}")

    print("\n--- Discovered Origins ---")
    for origin in sorted(origins):
        print(f"  [ORIGIN] {origin}")


if __name__ == '__main__':
    main()
