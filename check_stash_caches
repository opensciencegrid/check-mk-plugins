#!/usr/bin/env python3

import os
import sys
import json
import urllib.request
import traceback

STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3

def get_director_caches():
    """
    Fetches active cache server hostnames directly from the OSDF Director API endpoint.
    """
    url = "https://osdf-director.osg-htc.org/api/v1.0/director/servers"
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    
    caches = set()
    with urllib.request.urlopen(req) as resp:
        data_json = json.loads(resp.read().decode('utf-8'))
        
        for server in data_json:
            # Filter for server entries representing caches
            server_type = str(server.get('type', '')).lower()
            if server_type == 'cache':
                # Prefer 'endpoint', fallback to 'url' or 'auth_endpoint'
                endpoint = server.get('endpoint') or server.get('url') or server.get('auth_endpoint', '')
                if endpoint:
                    # Strip protocol (e.g. https://) and ports (e.g. :8444) to isolate FQDN
                    host = endpoint.split("//")[-1].split(":")[0].split("/")[0].strip()
                    if host:
                        caches.add(host)
                        
    return caches


def get_monitoring_caches(params):
    caches = set()
    url = f"http://127.0.0.1:5001/osgmon/check_mk/webapi.py?{params}"
    
    with urllib.request.urlopen(url) as response:
        s = response.read().decode('utf-8')
        data_json = json.loads(s)
        for host in data_json.get('result', {}):
            if data_json['result'][host].get('path') == 'stash-caches':
                caches.add(host)
                
    return caches


def main():
    states = [STATE_OK]
    messages = []

    # Fetch active caches from OSDF Director
    registry_caches = get_director_caches()

    # Safely retrieve OMD_ROOT with fallback to default site path
    omd_root = os.environ.get('OMD_ROOT', '/omd/sites/osgmon')
    secret_filepath = os.path.join(omd_root, "var/check_mk/web/automation/automation.secret")
    
    if not os.path.exists(secret_filepath):
        print(f"Error: Automation secret file not found at {secret_filepath}")
        sys.exit(STATE_UNKNOWN)

    with open(secret_filepath, 'r') as access:
        secret_line = access.readline().strip()

    action = "action=get_all_hosts"
    password = f"{action}&_username=automation&_secret={secret_line}"
    monitoring_caches = get_monitoring_caches(password)

    registry_diff = registry_caches.difference(monitoring_caches)
    monitoring_diff = monitoring_caches.difference(registry_caches)
    
    if len(registry_diff) > 0 or len(monitoring_diff) > 0:
        states.append(STATE_CRITICAL)

    messages.append("Hosts in OSDF Director and not in monitoring: ")
    messages.append(",".join(registry_diff) if registry_diff else "None")
    
    messages.append(". Hosts in monitoring and not in OSDF Director: ")
    messages.append(",".join(monitoring_diff) if monitoring_diff else "None")
    
    messages.append(f"\n| registry_diff = {len(registry_diff)} monitoring_diff = {len(monitoring_diff)}\n")

    print("".join(messages)) 
    sys.exit(max(states))


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(f"Exception occurred when running probe V1: {exc}")
        var = traceback.format_exc()
        print(var)
        sys.exit(STATE_CRITICAL)
