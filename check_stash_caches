#!/usr/bin/env python3

import os
import sys
import json
import socket
import urllib.request
import urllib.parse
import traceback

STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3


def normalize(host):
    """
    Normalize a hostname: strip whitespace, lowercase, drop trailing dot,
    and strip port if present.
    """
    if not host:
        return ""
    h = host.strip().lower().rstrip('.')
    if not h.startswith('[') and ':' in h:
        h = h.rsplit(':', 1)[0]
    return h


def ensure_fqdn(host):
    """
    Returns the normalized FQDN if valid. Discards non-FQDN identifiers
    unless local DNS can resolve them to a valid domain containing dots.
    """
    h = normalize(host)
    if not h:
        return None

    # Accept directly if it contains domain dots
    if '.' in h:
        return h

    # Attempt local DNS reverse/forward lookup for shortnames
    try:
        fqdn = socket.getfqdn(h)
        if fqdn and '.' in fqdn:
            return normalize(fqdn)
    except Exception:
        pass

    # Strictly discard shortnames or custom identifiers without domain dots
    return None


def get_registry_servers():
    """
    Fetches active cache and origin server hostnames directly from the OSDF Director API.
    Handles extractions from standard fields, namespace prefixes, and endpoint fallback parsing.
    Returns a tuple of sets: (caches, origins).
    """
    url = "https://osdf-director.osg-htc.org/api/v1.0/director_ui/servers"
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})

    caches = set()
    origins = set()

    with urllib.request.urlopen(req, timeout=10) as resp:
        data_json = json.loads(resp.read().decode('utf-8'))

        # Standardize payload structure if wrapped under a root key
        servers = data_json.get('servers', data_json) if isinstance(data_json, dict) else data_json

        for server in servers:
            srv_type = str(server.get('type', '') or server.get('filtered_type', '')).lower()
            is_cache = server.get('is_cache') is True or srv_type == 'cache'
            is_origin = server.get('is_origin') is True or srv_type == 'origin'

            candidate_hosts = []

            # 1. Extract host candidates from server attributes
            for key in ('endpoint', 'url', 'auth_url', 'web_url', 'webUrl', 'server_url', 'hostname', 'name'):
                val = server.get(key)
                if val and isinstance(val, str):
                    if '://' in val:
                        parsed = urllib.parse.urlparse(val)
                        if parsed.hostname:
                            candidate_hosts.append(parsed.hostname)
                    else:
                        candidate_hosts.append(val)

            # 2. Extract host candidates from namespace registration prefixes
            for reg in server.get('registration', []):
                prefix = reg.get('prefix', '')
                if prefix.startswith('/caches/'):
                    is_cache = True
                    host = prefix[len('/caches/'):].strip('/')
                    if host:
                        candidate_hosts.append(host)
                elif prefix.startswith('/origins/'):
                    is_origin = True
                    host = prefix[len('/origins/'):].strip('/')
                    if host:
                        candidate_hosts.append(host)

            # 3. Categorize valid FQDNs into respective sets
            for raw_host in candidate_hosts:
                fqdn = ensure_fqdn(raw_host)
                if fqdn:
                    if is_cache:
                        caches.add(fqdn)
                    if is_origin:
                        origins.add(fqdn)

    return caches, origins


def get_automation_secret():
    """Reads the Checkmk secret from the local site directory (~/var/check_mk/web/automation/automation.secret)."""
    secret_path = os.path.expanduser(
        "~/var/check_mk/web/automation/automation.secret"
    )
    try:
        with open(secret_path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except FileNotFoundError:
        print(f"Warning: Automation secret file not found at {secret_path}")
        return None
    except Exception as e:
        print(f"Warning: Failed to read automation secret file: {e}")
        return None

def get_monitoring_servers(username="automation"):
    """Fetches monitored cache and origin hosts from Checkmk REST API (v1.0).

    Returns a tuple of sets: (caches, origins).
    """
    caches = set()
    origins = set()

    # Checkmk v1.0 REST API endpoint for retrieving all configured hosts
    url = "http://127.0.0.1:5000/osgmon/check_mk/api/1.0/domain-types/host_config/collections/all"

    headers = {
        "Accept": "application/json",
    }

    secret = get_automation_secret()
    print(secret)
    if secret:
        headers["Authorization"] = f"Bearer {username} {secret}"


    req = urllib.request.Request(url, headers=headers)

    try:
        with urllib.request.urlopen(req, timeout=10) as response:
            s = response.read().decode("utf-8")
            data_json = json.loads(s)

            # REST API returns host items under the 'value' key
            hosts = data_json.get("value", [])

            for host_item in hosts:
                # Primary host identifier or title
                host_id = host_item.get("id") or host_item.get("title")

                # Extract extensions and attributes
                extensions = host_item.get("extensions", {})
                folder = extensions.get("folder", "").strip("/").lower()
                attributes = extensions.get("attributes", {})

                if folder in ("osdf/osdf_caches", "osdf/osdf_origins"):
                    candidates = []
                    if host_id:
                        candidates.append(host_id)

                    # Extract optional alias or IP address attributes if present
                    if "alias" in attributes:
                        candidates.append(attributes["alias"])
                    if "ipaddress" in attributes:
                        candidates.append(attributes["ipaddress"])

                    # Try resolving candidates to find a valid FQDN
                    for candidate in candidates:
                        fqdn = ensure_fqdn(candidate)
                        if fqdn:
                            if folder == "osdf/osdf_caches":
                                caches.add(fqdn)
                            elif folder == "osdf/osdf_origins":
                                origins.add(fqdn)
                            break

    except Exception as e:
        print(f"Error fetching hosts from Checkmk REST API: {e}")

    # These hosts are registered as Access Points
    origins.add("ap40.uw.osg-htc.org")
    origins.add("ap41.uw.osg-htc.org")
    origins.add("ap43.uw.osg-htc.org")

    return caches, origins

def main():
    states = [STATE_OK]
    messages = []

    # 1. Fetch active cache and origin FQDNs from OSDF Director
    registry_caches, registry_origins = get_registry_servers()

    # 2. Authenticate and fetch monitored hosts from Checkmk
    omd_root = os.environ.get('OMD_ROOT', '/omd/sites/osgmon')
    secret_filepath = os.path.join(omd_root, "var/check_mk/web/automation/automation.secret")

    if not os.path.exists(secret_filepath):
        print(f"UNKNOWN - Automation secret file not found at {secret_filepath}")
        sys.exit(STATE_UNKNOWN)

    with open(secret_filepath, 'r') as access:
        secret_line = access.readline().strip()

    action = "action=get_all_hosts"
    password = f"{action}&_username=automation&_secret={secret_line}"
    monitoring_caches, monitoring_origins = get_monitoring_servers(password)

    # 3. Calculate set differences
    cache_reg_diff = registry_caches.difference(monitoring_caches)
    cache_mon_diff = monitoring_caches.difference(registry_caches)

    origin_reg_diff = registry_origins.difference(monitoring_origins)
    origin_mon_diff = monitoring_origins.difference(registry_origins)

    if (cache_reg_diff or cache_mon_diff or origin_reg_diff or origin_mon_diff):
        states.append(STATE_CRITICAL)

    # Output messages
    messages.append("Caches in Director not in monitoring: ")
    messages.append(",".join(sorted(cache_reg_diff)) if cache_reg_diff else "None")

    messages.append(". Caches in monitoring not in Director: ")
    messages.append(",".join(sorted(cache_mon_diff)) if cache_mon_diff else "None")

    messages.append(". Origins in Director not in monitoring: ")
    messages.append(",".join(sorted(origin_reg_diff)) if origin_reg_diff else "None")

    messages.append(". Origins in monitoring not in Director: ")
    messages.append(",".join(sorted(origin_mon_diff)) if origin_mon_diff else "None")

    # Performance metrics string for Checkmk
    perf_data = (
        f"\n| cache_reg_diff={len(cache_reg_diff)} "
        f"cache_mon_diff={len(cache_mon_diff)} "
        f"origin_reg_diff={len(origin_reg_diff)} "
        f"origin_mon_diff={len(origin_mon_diff)}\n"
    )
    messages.append(perf_data)

    print("".join(messages))
    sys.exit(max(states))


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(f"CRITICAL - Exception occurred when running probe: {exc}")
        var = traceback.format_exc()
        print(var)
        sys.exit(STATE_CRITICAL)
