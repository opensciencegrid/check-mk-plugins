#!/usr/bin/env python3

import os
import sys
import json
import socket
import urllib.request
import urllib.parse
import traceback

STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3


def normalize(host):
    """
    Normalize a hostname: strip whitespace, lowercase, drop trailing dot,
    and strip port if present.
    """
    if not host:
        return ""
    h = host.strip().lower().rstrip('.')
    if not h.startswith('[') and ':' in h:
        h = h.rsplit(':', 1)[0]
    return h


def ensure_fqdn(host):
    """
    Returns the normalized FQDN if valid. Discards non-FQDN identifiers
    unless local DNS can resolve them to a valid domain containing dots.
    """
    h = normalize(host)
    if not h:
        return None

    # Accept directly if it contains domain dots
    if '.' in h:
        return h

    # Attempt local DNS reverse/forward lookup for shortnames
    try:
        fqdn = socket.getfqdn(h)
        if fqdn and '.' in fqdn:
            return normalize(fqdn)
    except Exception:
        pass

    # Strictly discard shortnames or custom identifiers without domain dots
    return None


def get_registry_caches():
    """
    Fetches active cache server hostnames directly from the OSDF Director API endpoint
    (https://osdf-director.osg-htc.org/api/v1.0/director_ui/servers) and returns
    a set containing strictly valid FQDNs.
    """
    url = "https://osdf-director.osg-htc.org/api/v1.0/director_ui/servers"
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})

    caches = set()
    with urllib.request.urlopen(req, timeout=10) as resp:
        data_json = json.loads(resp.read().decode('utf-8'))

        for server in data_json:
            # Check if entry represents a cache
            is_cache = (
                server.get('is_cache') is True or
                str(server.get('type', '')).lower() == 'cache' or
                str(server.get('filtered_type', '')).lower() == 'cache'
            )

            if is_cache:
                candidate_hosts = []

                # 1. Extract host candidates from endpoint / url / hostname attributes
                for key in ('endpoint', 'url', 'auth_url', 'web_url', 'server_url', 'hostname', 'name'):
                    val = server.get(key)
                    if val and isinstance(val, str):
                        if '://' in val:
                            parsed = urllib.parse.urlparse(val)
                            if parsed.hostname:
                                candidate_hosts.append(parsed.hostname)
                        else:
                            candidate_hosts.append(val)

                # 2. Extract host candidates from registration prefix segment if present
                for reg in server.get('registration', []):
                    prefix = reg.get('prefix', '')
                    if prefix.startswith('/caches/'):
                        host = prefix[len('/caches/'):].strip('/')
                        if host:
                            candidate_hosts.append(host)

                # 3. Filter and convert candidates strictly to valid FQDNs
                for raw_host in candidate_hosts:
                    fqdn = ensure_fqdn(raw_host)
                    if fqdn:
                        caches.add(fqdn)

    return caches


def get_monitoring_caches(params):
    """
    Fetches monitored cache hosts from Checkmk API and converts them strictly to FQDNs.
    """
    caches = set()
    url = f"http://127.0.0.1:5001/osgmon/check_mk/webapi.py?{params}"

    with urllib.request.urlopen(url, timeout=10) as response:
        s = response.read().decode('utf-8')
        data_json = json.loads(s)
        result = data_json.get('result', {})

        for host, info in result.items():
            path = (info.get('path') or '').strip('/').lower()
            if path == 'stash-caches':
                candidates = [host]

                # Extract optional alias or IP address attributes from Checkmk
                attributes = info.get('attributes', {})
                if 'alias' in attributes:
                    candidates.append(attributes['alias'])
                if 'ipaddress' in attributes:
                    candidates.append(attributes['ipaddress'])

                # Try resolving candidates to find a valid FQDN
                for candidate in candidates:
                    fqdn = ensure_fqdn(candidate)
                    if fqdn:
                        caches.add(fqdn)
                        break

    return caches


def main():
    states = [STATE_OK]
    messages = []

    # 1. Fetch active cache FQDNs from OSDF Director
    registry_caches = get_registry_caches()

    # 2. Authenticate and fetch cache FQDNs from Checkmk monitoring
    omd_root = os.environ.get('OMD_ROOT', '/omd/sites/osgmon')
    secret_filepath = os.path.join(omd_root, "var/check_mk/web/automation/automation.secret")

    if not os.path.exists(secret_filepath):
        print(f"UNKNOWN - Automation secret file not found at {secret_filepath}")
        sys.exit(STATE_UNKNOWN)

    with open(secret_filepath, 'r') as access:
        secret_line = access.readline().strip()

    action = "action=get_all_hosts"
    password = f"{action}&_username=automation&_secret={secret_line}"
    monitoring_caches = get_monitoring_caches(password)

    # 3. Calculate set differences
    registry_diff = registry_caches.difference(monitoring_caches)
    monitoring_diff = monitoring_caches.difference(registry_caches)

    if len(registry_diff) > 0 or len(monitoring_diff) > 0:
        states.append(STATE_CRITICAL)

    messages.append("Hosts in OSDF Director and not in monitoring: ")
    messages.append(",".join(sorted(registry_diff)) if registry_diff else "None")

    messages.append(". Hosts in monitoring and not in OSDF Director: ")
    messages.append(",".join(sorted(monitoring_diff)) if monitoring_diff else "None")

    messages.append(f"\n| registry_diff={len(registry_diff)} monitoring_diff={len(monitoring_diff)}\n")

    print("".join(messages))
    sys.exit(max(states))


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(f"CRITICAL - Exception occurred when running probe V1: {exc}")
        var = traceback.format_exc()
        print(var)
        sys.exit(STATE_CRITICAL)
