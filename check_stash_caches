#!/usr/bin/env python3

import os
import sys
import json
import urllib.request
import traceback

STATE_OK = 0
STATE_WARNING = 1
STATE_CRITICAL = 2
STATE_UNKNOWN = 3


def normalize(host):
    """Normalize a hostname for comparison: strip whitespace, lowercase,
    drop trailing dot, drop port if present."""
    if not host:
        return host
    h = host.strip().lower().rstrip('.')
    # Strip a trailing :port if present (but not IPv6 literals in brackets)
    if not h.startswith('[') and ':' in h:
        h = h.rsplit(':', 1)[0]
    return h


def get_registry_caches():
    """
    Fetches active cache server hostnames directly from the OSDF Registry API endpoint.
    """
    url = "https://osdf-registry.osg-htc.org/api/v1.0/registry_ui/servers"
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})

    caches = set()
    with urllib.request.urlopen(req) as resp:
        data_json = json.loads(resp.read().decode('utf-8'))

        for server in data_json:
            # Check boolean field for caches
            if server.get('is_cache') is True:
                # There is no top-level 'hostname' field in this API's
                # response. The hostname lives in each registration's
                # 'prefix', e.g. "/caches/xcachevirgo.pic.es" or
                # "/caches/PURDUE_OSDF_CACHE" -> strip the leading
                # "/caches/" segment to get the host/name.
                for reg in server.get('registration', []):
                    prefix = reg.get('prefix', '')
                    if prefix.startswith('/caches/'):
                        host = prefix[len('/caches/'):].strip('/')
                        if host:
                            caches.add(normalize(host))

    print("registry")
    print(caches)
    return caches


def get_monitoring_caches(params):
    caches = set()
    url = f"http://127.0.0.1:5001/osgmon/check_mk/webapi.py?{params}"

    with urllib.request.urlopen(url) as response:
        s = response.read().decode('utf-8')
        data_json = json.loads(s)
        result = data_json.get('result', {})
        for host, info in result.items():
            # 'path' comes back from the webapi with leading/trailing
            # slashes, e.g. "/stash-caches" or "/stash-caches/", so a bare
            # equality check against "stash-caches" never matches. Strip
            # slashes (and normalize case) before comparing.
            path = (info.get('path') or '').strip('/').lower()
            if path == 'stash-caches':
                caches.add(normalize(host))

    print("checkmk")
    print(caches)
    return caches


def main():
    states = [STATE_OK]
    messages = []

    # Fetch active caches from OSDF Registry
    registry_caches = get_registry_caches()

    # Safely retrieve OMD_ROOT with fallback to default site path
    omd_root = os.environ.get('OMD_ROOT', '/omd/sites/osgmon')
    secret_filepath = os.path.join(omd_root, "var/check_mk/web/automation/automation.secret")

    if not os.path.exists(secret_filepath):
        print(f"Error: Automation secret file not found at {secret_filepath}")
        sys.exit(STATE_UNKNOWN)

    with open(secret_filepath, 'r') as access:
        secret_line = access.readline().strip()

    action = "action=get_all_hosts"
    password = f"{action}&_username=automation&_secret={secret_line}"
    monitoring_caches = get_monitoring_caches(password)

    registry_diff = registry_caches.difference(monitoring_caches)
    monitoring_diff = monitoring_caches.difference(registry_caches)

    if len(registry_diff) > 0 or len(monitoring_diff) > 0:
        states.append(STATE_CRITICAL)

    messages.append("Hosts in OSDF Registry and not in monitoring: ")
    messages.append(",".join(sorted(registry_diff)) if registry_diff else "None")

    messages.append(". Hosts in monitoring and not in OSDF Registry: ")
    messages.append(",".join(sorted(monitoring_diff)) if monitoring_diff else "None")

    messages.append(f"\n| registry_diff = {len(registry_diff)} monitoring_diff = {len(monitoring_diff)}\n")

    print("".join(messages))
    sys.exit(max(states))


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(f"Exception occurred when running probe V1: {exc}")
        var = traceback.format_exc()
        print(var)
        sys.exit(STATE_CRITICAL)
